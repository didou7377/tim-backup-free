{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.1",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "activatePlugin",
      "pluginName": "TIM Backup",
      "pluginPath": "tim-backup/tim-backup.php"
    },
    {
      "step": "runPHP",
      "code": "<?php\ndefine( 'WP_CLI', true );\nrequire_once '/wordpress/wp-load.php';\nrequire '/wordpress/wp-content/plugins/tim-backup/tests/playground-smoke.php';\n"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "plugin-check"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "wp-cli",
      "command": "wp plugin check tim-backup"
    }
  ]
}
