msgid "The saved database restore job is invalid."
msgstr "Der gespeicherte Auftrag zur Datenbankwiederherstellung ist ungültig."

#: includes/class-tim-backup-restore-job-service.php:1302
msgid ""
"The rollback cannot be removed while restore recovery is still required."
msgstr ""
"Der Rollback kann nicht entfernt werden, solange er noch für die "
"Wiederherstellung benötigt wird."

#. translators: 1: Rollback size, 2: Automatic deletion date.
#: includes/class-tim-backup-restore-job-service.php:1453
#, php-format
msgid "Rollback size: %1$s. Automatic cleanup: %2$s."
msgstr "Rollback-Größe: %1$s. Automatisches Aufräumen: %2$s."

#. translators: %s: Rollback size.
#: includes/class-tim-backup-restore-job-service.php:1459
#, php-format
msgid "Rollback size: %s. It is retained until recovery is complete."
msgstr ""
"Rollback-Größe: %s. Er bleibt erhalten, bis die Wiederherstellung "
"abgeschlossen ist."

#: includes/class-tim-backup-restore-job-service.php:1485
#: includes/class-tim-backup-restore-job-service.php:1502
msgid "The saved database restore progress failed its integrity check."
msgstr ""
"Der gespeicherte Fortschritt der Datenbankwiederherstellung hat die "
"Integritätsprüfung nicht bestanden."

#: includes/class-tim-backup-restore-job-service.php:1528
#: includes/class-tim-backup-restore-job-service.php:1539
msgid "The database restore progress could not be saved."
msgstr ""
"Der Fortschritt der Datenbankwiederherstellung konnte nicht gespeichert "
"werden."

#: includes/class-tim-backup-restore-job-service.php:1598
msgid "The rollback was completed successfully."
msgstr "Der Rollback wurde erfolgreich durchgeführt."

#: includes/class-tim-backup-restore-job-service.php:1601
msgid ""
"The database was restored successfully. The rollback will be retained for "
"ten days."
msgstr ""
"Die Datenbank wurde erfolgreich wiederhergestellt. Der Rollback wird zehn "
"Tage aufbewahrt."

#: includes/class-tim-backup-restore-job-service.php:1602
msgid "The database was restored successfully. The rollback has been removed."
msgstr ""
"Die Datenbank wurde erfolgreich wiederhergestellt. Der Rollback wurde "
"entfernt."

#: includes/class-tim-backup-restore-job-service.php:1651
msgid "TIM Backup could not enable protected restore maintenance mode."
msgstr ""
"TIM Backup konnte den geschützten Wartungsmodus für die Wiederherstellung "
"nicht aktivieren."

#: includes/class-tim-backup-restore-job-service.php:1673
msgid "TIM Backup could not disable restore maintenance mode."
msgstr ""
"TIM Backup konnte den Wartungsmodus für die Wiederherstellung nicht "
"deaktivieren."

#: includes/class-tim-backup-restore-job-service.php:1715
msgid "The protected restore journal key is invalid."
msgstr ""
"Der geschützte Journalschlüssel für die Wiederherstellung ist ungültig."

#: includes/class-tim-backup-restore-job-service.php:1730
msgid "The protected restore journal key could not be created."
