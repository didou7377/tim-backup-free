#: includes/class-tim-backup-storage.php:60
msgid ""
"The backup directory must be outside the public document root. Define "
"TIM_BACKUP_STORAGE_DIR with a private writable path."
msgstr ""
"Das Backup-Verzeichnis muss außerhalb des öffentlichen Dokumentenstamms "
"liegen. Definiere TIM_BACKUP_STORAGE_DIR mit einem privaten beschreibbaren Pfad."

#: includes/class-tim-backup-storage.php:67
msgid ""
"TIM Backup could not create private storage outside the document root. "
"Define TIM_BACKUP_STORAGE_DIR with a writable private path."
msgstr ""
"TIM Backup konnte außerhalb des Dokumentenstamms keinen privaten Speicher "
"erstellen. Definiere TIM_BACKUP_STORAGE_DIR mit einem beschreibbaren privaten "
"Pfad."

#: includes/class-tim-backup-storage.php:83
msgid "TIM Backup could not protect its storage directory."
msgstr "TIM Backup konnte sein Speicherverzeichnis nicht schützen."

#: includes/class-tim-backup-storage.php:165
msgid "The backup identifier is invalid."
msgstr "Die Backup-Kennung ist ungültig."

#: includes/class-tim-backup-storage.php:232
msgid "The requested backup does not exist."
msgstr "Das angeforderte Backup existiert nicht."

#: includes/class-tim-backup-storage.php:247
msgid "The backup metadata is invalid."
msgstr "Die Backup-Metadaten sind ungültig."

#: includes/class-tim-backup-storage.php:276
msgid "No backup could be selected for local rotation."
msgstr "Für die lokale Rotation konnte kein Backup ausgewählt werden."

#: includes/class-tim-backup-storage.php:295
msgid "The backup index could not be updated."
msgstr "Der Backup-Index konnte nicht aktualisiert werden."

#: includes/class-tim-backup-storage.php:348
msgid "The backup index could not be preserved after restore."
msgstr ""
"Der Backup-Index konnte nach der Wiederherstellung nicht beibehalten werden."

#: includes/class-tim-backup-storage.php:377
msgid "The backup archive could not be deleted."
msgstr "Das Backup-Archiv konnte nicht gelöscht werden."

#: includes/class-tim-backup-storage.php:414
msgid "Another TIM Backup operation is already running."
msgstr "Ein anderer TIM-Backup-Vorgang wird bereits ausgeführt."

#: includes/class-tim-backup-backup-service.php:52
msgid "The requested backup type is invalid."
msgstr "Der angeforderte Backup-Typ ist ungültig."

#: includes/class-tim-backup-backup-service.php:59
msgid "The PHP ZIP extension is required to create backups."
msgstr "Die PHP-ZIP-Erweiterung wird zum Erstellen von Backups benötigt."

#: includes/class-tim-backup-backup-service.php:99
msgid "The completed backup archive could not be finalized."
msgstr "Das abgeschlossene Backup-Archiv konnte nicht finalisiert werden."

#: includes/class-tim-backup-backup-service.php:121
msgid "The completed backup archive could not be hashed."
msgstr "Für das fertige Backup-Archiv konnte kein Hash erstellt werden."

#: includes/class-tim-backup-backup-service.php:159
msgid "The backup archive does not exist."
msgstr "Das Backup-Archiv existiert nicht."

#: includes/class-tim-backup-backup-service.php:168
msgid "The backup archive is not a readable ZIP file."
msgstr "Das Backup-Archiv ist keine lesbare ZIP-Datei."

#: includes/class-tim-backup-backup-service.php:178
msgid "The backup manifest is missing."
msgstr "Das Backup-Manifest fehlt."

#: includes/class-tim-backup-backup-service.php:193
msgid "The backup manifest is invalid or unsupported."
msgstr "Das Backup-Manifest ist ungültig oder wird nicht unterstützt."

#: includes/class-tim-backup-backup-service.php:205
msgid "The backup signature is invalid. The archive may have been changed."
msgstr ""
"Die Backup-Signatur ist ungültig. Das Archiv wurde möglicherweise verändert."

#: includes/class-tim-backup-backup-service.php:213
msgid "This backup belongs to a different WordPress site."
msgstr "Dieses Backup gehört zu einer anderen WordPress-Website."

#: includes/class-tim-backup-backup-service.php:240
msgid "The backup contains an unexpected, duplicate, or unsafe archive entry."
msgstr ""
"Das Backup enthält einen unerwarteten, doppelten oder unsicheren "
"Archiveintrag."

#: includes/class-tim-backup-backup-service.php:251
msgid "The backup archive contents do not match its signed manifest."
msgstr ""
"Der Inhalt des Backup-Archivs stimmt nicht mit seinem signierten Manifest "
"überein."

#: includes/class-tim-backup-backup-service.php:260
msgid "The backup contains an unsafe archive path."
msgstr "Das Backup enthält einen unsicheren Archivpfad."

#: includes/class-tim-backup-backup-service.php:270
msgid "A file recorded by the backup manifest is missing."
msgstr "Eine im Backup-Manifest verzeichnete Datei fehlt."

#: includes/class-tim-backup-backup-service.php:282
msgid "A backup file failed its integrity check."
msgstr "Eine Backup-Datei hat die Integritätsprüfung nicht bestanden."

#: includes/class-tim-backup-backup-service.php:306
msgid "TIM Backup could not create a temporary working directory."
msgstr "TIM Backup konnte kein temporäres Arbeitsverzeichnis erstellen."

#: includes/class-tim-backup-backup-service.php:315
msgid "TIM Backup could not create the backup archive."
msgstr "TIM Backup konnte das Backup-Archiv nicht erstellen."

#: includes/class-tim-backup-backup-service.php:353
msgid "TIM Backup could not write the archive manifest."
msgstr "TIM Backup konnte das Archiv-Manifest nicht schreiben."

#: includes/class-tim-backup-backup-service.php:360
msgid "TIM Backup could not finish writing the backup archive."
msgstr "TIM Backup konnte das Schreiben des Backup-Archivs nicht abschließen."

#: includes/class-tim-backup-backup-service.php:386
msgid "The database could not start a repeatable-read backup transaction."
msgstr "Die Datenbank konnte keine Repeatable-Read-Backup-Transaktion starten."

#: includes/class-tim-backup-backup-service.php:396
msgid "The database could not start a consistent backup transaction."
msgstr "Die Datenbank konnte keine konsistente Backup-Transaktion starten."

#: includes/class-tim-backup-backup-service.php:415
msgid "No WordPress database tables were found."
msgstr "Es wurden keine WordPress-Datenbanktabellen gefunden."

#: includes/class-tim-backup-backup-service.php:429
msgid "A database table has an unsafe name and cannot be backed up."
msgstr ""
"Eine Datenbanktabelle hat einen unsicheren Namen und kann nicht gesichert "
"werden."

#: includes/class-tim-backup-backup-service.php:440
msgid "A database table schema could not be exported."
msgstr "Ein Datenbanktabellenschema konnte nicht exportiert werden."

#: includes/class-tim-backup-backup-service.php:449
msgid ""
"A prefixed database object is not a base table and cannot be backed up by "
"this version."
msgstr ""
"Ein Datenbankobjekt mit Präfix ist keine Basistabelle und kann mit dieser "
"Version nicht gesichert werden."

#: includes/class-tim-backup-backup-service.php:464
msgid "All backed-up tables must use InnoDB for a consistent snapshot."
msgstr "Alle gesicherten Tabellen müssen für einen konsistenten Snapshot InnoDB verwenden."

#: includes/class-tim-backup-backup-service.php:478
msgid "Every backed-up table must have a primary key for deterministic export."
msgstr "Jede gesicherte Tabelle benötigt für einen deterministischen Export einen Primärschlüssel."

#: includes/class-tim-backup-backup-service.php:499
msgid "A primary-key column has an unsafe name."
msgstr "Eine Primärschlüsselspalte hat einen unsicheren Namen."

#: includes/class-tim-backup-backup-service.php:520
msgid "A temporary database export file could not be created."
msgstr "Eine temporäre Datenbankexportdatei konnte nicht erstellt werden."

#: includes/class-tim-backup-backup-service.php:540
msgid "Database rows could not be exported."
msgstr "Datenbankzeilen konnten nicht exportiert werden."

#: includes/class-tim-backup-backup-service.php:557
msgid "Database export data could not be written."
msgstr "Datenbankexportdaten konnten nicht geschrieben werden."

#: includes/class-tim-backup-backup-service.php:574
msgid "Database export data could not be added to the archive."
msgstr "Datenbankexportdaten konnten dem Archiv nicht hinzugefügt werden."

#: includes/class-tim-backup-backup-service.php:585
msgid "Database export data could not be hashed."
msgstr "Für Datenbankexportdaten konnte kein Hash erstellt werden."

#: includes/class-tim-backup-backup-service.php:600
msgid "The database schema could not be added to the archive."
msgstr "Das Datenbankschema konnte dem Archiv nicht hinzugefügt werden."

#: includes/class-tim-backup-backup-service.php:611
msgid "The consistent database snapshot could not be completed."
msgstr "Der konsistente Datenbank-Snapshot konnte nicht abgeschlossen werden."

#: includes/class-tim-backup-backup-service.php:633
msgid "The WordPress or backup storage path could not be resolved."
msgstr "Der WordPress- oder Backup-Speicherpfad konnte nicht aufgelöst werden."

#: includes/class-tim-backup-backup-service.php:671
msgid "A WordPress file could not be added to the backup archive."
msgstr ""
"Eine WordPress-Datei konnte dem Backup-Archiv nicht hinzugefügt werden."

#: includes/class-tim-backup-backup-service.php:680
msgid "A WordPress file could not be hashed."
msgstr "Für eine WordPress-Datei konnte kein Hash erstellt werden."

#: includes/class-tim-backup-backup-service.php:689
msgid "A WordPress directory could not be read during backup."
msgstr ""
"Ein WordPress-Verzeichnis konnte während des Backups nicht gelesen werden."

#: includes/class-tim-backup-restore-service.php:81
msgid "The verified backup archive could not be opened for restore."
msgstr ""
"Das geprüfte Backup-Archiv konnte nicht zur Wiederherstellung geöffnet "
"werden."

#: includes/class-tim-backup-restore-service.php:114
msgid "The database schema in the backup is invalid."
msgstr "Das Datenbankschema im Backup ist ungültig."

#: includes/class-tim-backup-restore-service.php:121
msgid "The database prefix is too long for a safe staged restore."
msgstr ""
"Das Datenbankpräfix ist für eine sichere gestaffelte Wiederherstellung zu "
"lang."

#: includes/class-tim-backup-restore-service.php:140
msgid "A database table schema cannot be restored safely by this version."
msgstr ""
"Ein Datenbanktabellenschema kann mit dieser Version nicht sicher "
"wiederhergestellt werden."

#: includes/class-tim-backup-restore-service.php:153
msgid "A temporary database table name is invalid."
msgstr "Ein temporärer Datenbanktabellenname ist ungültig."

#: includes/class-tim-backup-restore-service.php:166
msgid "A database CREATE statement did not match its table."
msgstr "Eine CREATE-Anweisung der Datenbank passte nicht zu ihrer Tabelle."

#: includes/class-tim-backup-restore-service.php:177
msgid "A temporary database table could not be created."
msgstr "Eine temporäre Datenbanktabelle konnte nicht erstellt werden."

#: includes/class-tim-backup-restore-service.php:195
msgid "Database table data is missing from the backup."
msgstr "Daten einer Datenbanktabelle fehlen im Backup."

#: includes/class-tim-backup-restore-service.php:208
msgid "A database row in the backup is invalid."
msgstr "Eine Datenbankzeile im Backup ist ungültig."

#: includes/class-tim-backup-restore-service.php:221
msgid "A database column name in the backup is invalid."
msgstr "Ein Datenbankspaltenname im Backup ist ungültig."

#: includes/class-tim-backup-restore-service.php:233
msgid "A database value in the backup is invalid."
msgstr "Ein Datenbankwert im Backup ist ungültig."

#: includes/class-tim-backup-restore-service.php:246
msgid "A database row could not be restored."
msgstr "Eine Datenbankzeile konnte nicht wiederhergestellt werden."

#: includes/class-tim-backup-restore-service.php:267
msgid "The restored database tables could not be activated."
msgstr ""
"Die wiederhergestellten Datenbanktabellen konnten nicht aktiviert werden."

