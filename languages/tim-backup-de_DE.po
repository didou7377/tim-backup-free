msgstr "Erstelle oben ein vollständiges oder ein Datenbank-Backup."

#: includes/class-tim-backup-admin.php:285
#: includes/class-tim-backup-admin.php:316
msgid "Full backup"
msgstr "Vollständiges Backup"

#: includes/class-tim-backup-admin.php:285
#: includes/class-tim-backup-admin.php:316
